{
  "name": "@modelshot/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./handoff": {
      "types": "./src/handoff/index.ts",
      "default": "./src/handoff/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "serve:e2e": "vite build --mode e2e --base /app/ && vite preview --base /app/ --strictPort --host 127.0.0.1"
  },
  "dependencies": {
    "@modelshot/brand": "workspace:*",
    "@modelshot/export": "workspace:*",
    "@modelshot/formats": "workspace:*",
    "@modelshot/looks": "workspace:*",
    "@modelshot/pathtracer": "workspace:*",
    "@modelshot/renderer-rt": "workspace:*",
    "@modelshot/scene": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "vite": "8.3.4",
    "pngjs": "^7.0.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^8.0.0"
  }
}
