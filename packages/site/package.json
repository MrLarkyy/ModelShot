{
  "name": "@modelshot/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:with-app": "vite build && vite build ../app --outDir ../site/dist/app --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "golden:update": "node scripts/refuseInCi.mjs && playwright test --update-snapshots=all landing.golden"
  },
  "dependencies": {
    "@modelshot/app": "workspace:*",
    "@modelshot/brand": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "vite": "8.3.4"
  }
}
