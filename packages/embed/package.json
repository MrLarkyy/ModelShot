{
  "name": "@modelshot/embed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/element.ts",
    "./src/frame/main.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "vite build && vite build --config vite.element.config.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "serve:e2e": "pnpm run build && vite preview --strictPort --host 127.0.0.1"
  },
  "dependencies": {
    "@modelshot/app": "workspace:*",
    "@modelshot/brand": "workspace:*",
    "@modelshot/formats": "workspace:*",
    "@modelshot/looks": "workspace:*"
  },
  "devDependencies": {
    "@modelshot/renderer-rt": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "vite": "8.3.4"
  }
}
