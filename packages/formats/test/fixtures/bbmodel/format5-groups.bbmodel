{
  "meta": { "format_version": "5.0", "model_format": "free", "box_uv": false },
  "name": "format5-groups",
  "resolution": { "width": 16, "height": 16 },
  "elements": [
    {
      "name": "base",
      "from": [-2, 0, -2],
      "to": [2, 8, 2],
      "origin": [0, 0, 0],
      "faces": {
        "north": { "uv": [0, 0, 4, 8], "texture": 0 },
        "east": { "uv": [4, 0, 8, 8], "texture": 0 },
        "south": { "uv": [8, 0, 12, 8], "texture": 0 },
        "west": { "uv": [12, 0, 16, 8], "texture": 0 },
        "up": { "uv": [0, 8, 4, 12], "texture": 0 },
        "down": { "uv": [4, 8, 8, 12], "texture": 0 }
      },
      "type": "cube",
      "uuid": "c-base"
    },
    {
      "name": "tip",
      "from": [-1, 8, -1],
      "to": [1, 12, 1],
      "origin": [0, 8, 0],
      "rotation": [0, 45, 0],
      "faces": {
        "north": { "uv": [8, 8, 10, 12], "texture": 0 },
        "east": { "uv": [10, 8, 12, 12], "texture": 0 },
        "south": { "uv": [12, 8, 14, 12], "texture": 0 },
        "west": { "uv": [14, 8, 16, 12], "texture": 0 },
        "up": { "uv": [8, 12, 10, 14], "texture": 0 },
        "down": { "uv": [10, 12, 12, 14], "texture": 0 }
      },
      "type": "cube",
      "uuid": "c-tip"
    },
    {
      "name": "pivot marker",
      "position": [0, 8, 0],
      "type": "locator",
      "uuid": "l-marker"
    },
    {
      "name": "sculpt",
      "vertices": { "a": [0, 0, 0], "b": [1, 0, 0], "c": [0, 1, 0] },
      "faces": { "f": { "vertices": ["a", "b", "c"], "uv": { "a": [0, 0], "b": [1, 0], "c": [0, 1] }, "texture": 0 } },
      "type": "mesh",
      "uuid": "m-sculpt"
    }
  ],
  "groups": [
    {
      "name": "stand",
      "origin": [0, 0, 0],
      "rotation": [0, 0, 0],
      "uuid": "g-stand",
      "export": true,
      "visibility": true
    },
    {
      "name": "spire",
      "origin": [0, 8, 0],
      "rotation": [0, 0, 30],
      "uuid": "g-spire",
      "export": true,
      "visibility": true
    }
  ],
  "outliner": [
    {
      "uuid": "g-stand",
      "isOpen": true,
      "children": ["c-base", { "uuid": "g-spire", "isOpen": false, "children": ["c-tip", "l-marker"] }]
    },
    "m-sculpt"
  ],
  "textures": [
