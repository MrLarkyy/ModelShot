{
  "name": "@modelshot/brand",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./css/tokens.css",
    "./illustration.css": "./css/illustration.css",
    "./fonts.css": "./css/fonts.css",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "fonts:sync": "node scripts/syncFonts.mjs",
    "icons:render": "node scripts/renderPngs.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0"
  }
}
